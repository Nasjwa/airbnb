<div class="auth-page">
  <div class="auth-card">
    <h1 class="auth-title">Forgot your password?</h1>
    <p class="auth-sub">Enter your email address below and we’ll send you a link to reset it.</p>

    <%= form_with scope: :user, url: password_path(:user), class: "auth-form" do |f| %>
      <div>
        <label>Email</label>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %>
      </div>

      <div class="auth-actions">
        <%= f.submit "Send reset instructions", class: "btn btn-primary" %>
        <%= link_to "Back to login", new_session_path(:user), class: "btn btn-ghost" %>
      </div>

      <div style="margin-top:10px;">
        Don’t have an account? <%= link_to "Sign up", new_registration_path(:user), class: "btn-link" %>
      </div>
    <% end %>
  </div>
</div>
