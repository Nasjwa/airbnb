<div class="auth-page">
  <div class="auth-card">
    <h1 class="auth-title">Sign up</h1>
    <p class="auth-sub">Create an account to book your next stay.</p>

    <%= form_with model: resource, url: registration_path(resource_name), class: "auth-form" do |f| %>
      <div>
        <label>Email</label>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %>
      </div>

      <div>
        <label>Password</label>
        <%= f.password_field :password, autocomplete: "new-password", class: "input" %>
        <% if @minimum_password_length %>
          <small class="text-muted"><%= @minimum_password_length %> characters minimum</small>
        <% end %>
      </div>

      <div>
        <label>Password confirmation</label>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>
      </div>

      <div class="auth-actions">
        <%= f.submit "Create account", class: "btn btn-primary" %>
        <%= link_to "Log in", new_session_path(resource_name), class: "btn btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
