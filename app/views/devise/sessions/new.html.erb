<div class="auth-page">
  <div class="auth-card">
    <% if notice %><div class="auth-flash"><%= notice %></div><% end %>
    <% if alert  %><div class="auth-flash"><%= alert  %></div><% end %>

    <h1 class="auth-title">Log in</h1>
    <p class="auth-sub">Welcome back! Enter your details below.</p>

    <%= form_with scope: :user, url: session_path(:user), class: "auth-form" do |f| %>
      <div>
        <label>Email</label>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %>
      </div>

      <div>
        <label>Password</label>
        <%= f.password_field :password, autocomplete: "current-password", class: "input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div>
          <label style="display:flex;align-items:center;gap:8px;">
            <%= f.check_box :remember_me %> Remember me
          </label>
        </div>
      <% end %>

      <div class="auth-actions">
        <%= f.submit "Log in", class: "btn btn-primary" %>
        <%= link_to "Forgot your password?", new_password_path(:user), class: "btn btn-ghost" %>
      </div>

      <div style="margin-top:10px;">
        New here? <%= link_to "Sign up", new_registration_path(:user), class: "btn-link" %>
      </div>
    <% end %>
  </div>
</div>
