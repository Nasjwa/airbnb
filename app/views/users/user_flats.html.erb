
<div class="container">
  <h1 class="text-center">Your flats are here!</h1>
  <div class="mt-4">
    <%= link_to "Add a new flat", new_flat_path, class: "btn btn-primary" %>
  </div>
  <div class="row mt-4 mb-5 gx-4 gy-5">
    <% @user_flats.each do |flat| %>
      <div class="col-md-4 mb-4 mt-15">
        <div class="flat-card p-3 border d-flex flex-column justify-content-between">
          <%= link_to flat_path(flat), class: "text-decoration-none text-dark" do %>
            <% if flat.photos.attached? %>
              <%= image_tag url_for(flat.photos.first), alt: flat.title, class: "img-fluid" %>
            <% else %>
              <p>No photo</p>
            <% end %>
            <h2 class="mt-2"><strong><%= flat.title %></strong></h2>
            <p><%= flat.description %></p>
            <p><strong>Location:</strong> <%= flat.location %></p>
          <% end %>
        </div>
        <div class="mt-2">
          <%= link_to "Edit", edit_flat_path(flat), class: "btn btn-primary" %>
          <%= link_to "Delete", flat_path(flat),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>

  </div>
</div>
