<div class="container">
  <h1 class="text-center mb-4">Your flats are here!</h1>

  <div class="mb-4">
    <%= link_to "Add a new flat", new_flat_path, class: "btn btn-primary" %>
  </div>

  <div class="row gx-4 gy-5 mb-5">
    <% @user_flats.each do |flat| %>
      <div class="col-md-4">
        <div class="flat-card p-3 border d-flex flex-column justify-content-between">
          <%= link_to flat_path(flat), class: "text-decoration-none text-dark" do %>

            <% if flat.photos.attached? %>
              <% if defined?(Cloudinary) %>
                <%= cl_image_tag flat.photos.first.key,
                    width: 800,
                    height: 500,
                    crop: :fill,
                    gravity: :auto,
                    fetch_format: :auto,
                    quality: :auto,
                    class: "img-fluid rounded" %>
              <% else %>
                <%= image_tag url_for(flat.photos.first),
                    alt: flat.title,
                    class: "img-fluid rounded" %>
              <% end %>
            <% else %>
              <%= image_tag "placeholder.jpg", alt: "No photo", class: "img-fluid rounded" %>
            <% end %>

            <div class="mt-3">
              <h2 class="h5 mb-1 fw-bold"><%= flat.title %></h2>
              <p class="mb-1 text-muted"><%= flat.description %></p>
              <p class="mb-0"><strong>Location:</strong> <%= flat.location %></p>
            </div>
          <% end %>
        </div>

        <div class="mt-2 d-flex gap-2">
          <%= link_to "Edit", edit_flat_path(flat), class: "btn btn-primary" %>
          <%= link_to "Delete", flat_path(flat),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                class: "btn btn-danger" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
