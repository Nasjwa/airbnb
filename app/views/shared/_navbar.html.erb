<nav class="abnb-navbar" role="navigation" aria-label="Main">
  <div class="abnb-container">
    <!-- Brand -->
    <%= link_to flats_path, class: "brand" do %>
      <%= image_tag "logo.png", alt: "Logo", class: "brand-logo" %>
      <span class="wordmark">AirHome</span>
    <% end %>

    <!-- Search (center) -->
    <%= form_with url: flats_path, method: :get, local: true, html: { class: "nav-search", role: "search" } do %>
      <%= text_field_tag :query, params[:query],
            placeholder: "Search stays, destinations…",
            class: "search-input",
            aria: { label: "Search" } %>
      <%= submit_tag "Search", class: "btn btn-primary" %>
    <% end %>

    <!-- Right actions (no Bootstrap) -->
    <div class="nav-actions">
      <% if user_signed_in? %>
        <!-- Native <details> for dropdown: no JS, no Bootstrap -->
        <details class="menu">
          <summary class="btn btn-secondary">My profile</summary>
          <ul class="menu-list" role="menu" aria-label="User menu">
            <li><%= link_to "My flats", user_flats_path(current_user), class: "menu-item", role: "menuitem" %></li>
            <li><%= link_to "My bookings", bookings_path, class: "menu-item", role: "menuitem" %></li>
            <li class="divider" aria-hidden="true"></li>
            <li><%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "menu-item", role: "menuitem" %></li>
          </ul>
        </details>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "btn btn-secondary" %>
        <%= link_to "Sign up", new_user_registration_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</nav>
