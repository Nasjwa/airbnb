<div class="booking-page">
  <div class="booking-card">
    <h1 class="booking-title">Book <%= @flat.title %></h1>
    <p class="booking-sub">Select your dates and number of guests.</p>

    <%= form_with model: [@flat, @booking], local: true, class: "booking-form" do |f| %>
      <div class="form-row">
        <div class="form-field">
          <%= f.label :start_date, "Start date" %>
          <%= f.date_field :start_date, class: "input" %>
        </div>

        <div class="form-field">
          <%= f.label :end_date, "End date" %>
          <%= f.date_field :end_date, class: "input" %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-field">
          <%= f.label :guests %>
          <%= f.number_field :guests, in: 1..20, class: "input" %>
        </div>
      </div>

      <div class="form-actions">
        <%= f.submit "Book this flat", class: "btn-primary" %>
        <%= link_to "Back to flat", flat_path(@flat), class: "btn-link" %>
      </div>
    <% end %>
  </div>
</div>
