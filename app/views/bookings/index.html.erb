<div class="booking-list-container">
  <h1 class="booking-list-title">My Bookings</h1>

  <% if notice %>
    <p class="flash flash-success"><%= notice %></p>
  <% end %>

  <% if @bookings.any? %>
    <div class="booking-grid">
      <% @bookings.each do |booking| %>
        <% flat = booking.flat %>

        <article class="booking-card-item">
          <%= link_to flat_path(flat), class: "thumb" do %>
            <%= flat_cover_image_tag(flat, size: [800, 500]) %>
          <% end %>

          <div class="content">
            <h3>
              <%= link_to (flat.title || flat.name || "Flat"), flat_path(flat) %>
            </h3>

            <p class="meta">
              <strong>Dates:</strong>
              <%= l booking.start_date, format: :long %> &rarr; <%= l booking.end_date, format: :long %>
            </p>

            <p class="meta"><strong>Guests:</strong> <%= booking.guests %></p>

            <div class="actions">
              <%= link_to "View flat", flat_path(flat), class: "btn btn-secondary" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <p>You have no bookings yet.</p>
  <% end %>
</div>
