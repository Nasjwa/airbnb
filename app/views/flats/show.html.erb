<div class="container flat-show">
  <% if @flat.photo.attached? %>
    <%= image_tag url_for(@flat.photo), alt: @flat.title, class: "flat-cover" %>
  <% else %>
    <p class="flat-no-photo">No photo</p>
  <% end %>

  <h2 class="flat-title"><%= @flat.title %></h2>
  <p class="flat-description"><%= @flat.description %></p>
  <p class="flat-meta"><strong>Location:</strong> <%= @flat.location %></p>

  <div class="flat-actions">
    <%= link_to "Book this flat", new_flat_booking_path(@flat), class: "btn btn-primary" %>
    <%= link_to "Back to flats", flats_path, class: "btn btn-secondary" %>
  </div>
</div>
