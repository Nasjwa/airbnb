<%= form_with(model: flat, local: true, class: "flat-form") do |f| %>
  <% if flat.errors.any? %>
    <div class="flat-errors">
      <h2><%= pluralize(flat.errors.count, "error") %> prevented this flat from saving:</h2>
      <ul>
        <% flat.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <label>Title</label>
    <%= f.text_field :title, class: "flat-input", placeholder: "e.g., Cozy studio in Lisbon" %>
  </div>

  <div>
    <label>Description</label>
    <%= f.text_area :description, class: "flat-input", placeholder: "Describe your flat…" %>
  </div>

  <div>
    <label>Location</label>
    <%= f.text_field :location, class: "flat-input", placeholder: "City, neighborhood…" %>
  </div>

  <div>
    <label>Upload photos</label>
    <%= f.file_field :photos, multiple: true, direct_upload: true, class: "flat-input" %>

    <% if flat.photos.attached? %>
      <div class="flat-photo-preview">
        <% flat.photos.each do |photo| %>
          <%= image_tag url_for(photo), alt: flat.title %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="flat-actions">
    <%= f.submit "Save flat", class: "btn btn-primary" %>
  </div>
<% end %>
