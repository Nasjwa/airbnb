<div class="container">
  <!-- <h1 class="text-center">Welcome to our airbnb app!</h1> -->
  <div class="row mt-4 gx-3 gy-4">
    <% @flats.each do |flat| %>
      <div class="col-md-4">
        <div class="flip-card">
          <div class="flip-card-inner">
            <div class="flip-card-front flat-card p-3 border d-flex flex-column justify-content-between">
                <% if flat.photos.attached? %>
                <%= image_tag flat.photos.first, alt: flat.title, class: "img-fluid" %>
                <% else %>
                  <p>No photo</p>
                <% end %>
                <div class="mt-2"> 
                  <h2><strong><%= flat.title %></strong></h2>
                  <p><strong>Location:</strong> <%= flat.location %></p>
                </div>
            </div>

            <div class="flip-card-back p-3 d-flex flex-column justify-content-center align-items-center text-center">
                <h4 class="flat-back-title mt-3"><%= flat.title %></h4>
              
              <div class="description flex-grow-1 d-flex align-items-center justify-content-center">  
                <p><%= flat.description %></p>
              </div>
              
              <div class="mt-auto text-center">
                <%= link_to flat_path(flat), class: "btn btn-primary mt-2" do %>
                  See the details
                <% end %>
              </div>
            </div>
          </div>    
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-3" id='map'
          style='width: 100%; height: 400px;'
          data-controller="map"
          data-map-api-key-value="<%= ENV['MAPBOX_API_KEY'] %>"
          data-map-markers-value="<%= @markers.to_json %>">
  </div>
</div>

